{
  "name": "@rulecad/fixings",
  "version": "0.1.8",
  "description": "Screws, nuts, washers and inserts from rule sets, and the holes and seats they need in printed parts: a fixing as a model with sourced figures, holes sized by what they are for, counterbores, countersinks, nut pockets and insert bosses that print without supports, light solids of the hardware for an assembly, threads cut for printing, and first sums for a joint (engagement, stripping, preload, seating, the sold length that fits).",
  "type": "module",
  "exports": {
    ".": {
      "types": "./fixings.d.mts",
      "default": "./fixings.mjs"
    }
  },
  "types": "./fixings.d.mts",
  "files": [
    "fixings.mjs",
    "model.mjs",
    "holes.mjs",
    "seats.mjs",
    "hardware.mjs",
    "threads.mjs",
    "strength.mjs",
    "draw.mjs",
    "pins.mjs",
    "magnets.mjs",
    "bolts.mjs",
    "snaps.mjs",
    "fixings.d.mts",
    "model.d.mts",
    "holes.d.mts",
    "seats.d.mts",
    "hardware.d.mts",
    "threads.d.mts",
    "strength.d.mts",
    "draw.d.mts",
    "pins.d.mts",
    "magnets.d.mts",
    "bolts.d.mts",
    "snaps.d.mts",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "license": "MIT",
  "keywords": ["screws", "fasteners", "threads", "3d-printing", "jscad", "cad"],
  "engines": {
    "node": ">=20.10"
  },
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JoniBach/rulecad.git",
    "directory": "packages/fixings"
  },
  "homepage": "https://github.com/JoniBach/rulecad/tree/main/packages/fixings#readme",
  "bugs": {
    "url": "https://github.com/JoniBach/rulecad/issues"
  },
  "scripts": {
    "test": "node --test"
  },
  "peerDependencies": {
    "@jscad/modeling": "^2.12.0"
  },
  "dependencies": {
    "@rulecad/rules": "^0.3.24",
    "@rulecad/shapes": "^0.4.4"
  }
}
