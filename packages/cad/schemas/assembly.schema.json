{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jonibach.github.io/rulecad/schemas/assembly.schema.json",
  "title": "rulecad assembly",
  "description": "Objects placed together: a fit check (fits between them, joints and poses) or a plate (everything printed at once).",
  "type": "object",
  "required": ["items"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "title": { "type": "string" },
    "description": { "type": "string" },
    "note": { "type": "string" },
    "kind": { "enum": ["fit", "plate"] },
    "packed": { "type": "object", "description": "Written by cad plates: which assembly this plate is for, its filament and gap, and each part's build hash, so a changed part re-packs only its plate", "required": ["of", "filament", "gap", "parts"], "additionalProperties": false, "properties": { "of": { "type": "string" }, "filament": { "type": "string" }, "gap": { "type": "number" }, "parts": { "type": "object" } } },
    "uses": { "type": "array", "items": { "type": "string" } },
    "requires": { "type": "object", "additionalProperties": { "type": "string" }, "description": "object → semver range" },
    "items": { "type": "array", "items": { "$ref": "#/$defs/item" } },
    "fits": { "type": "array", "items": { "$ref": "#/$defs/fit" } },
    "joints": { "type": "array", "items": { "$ref": "#/$defs/joint" } },
    "loops": { "type": "array", "items": { "$ref": "#/$defs/loop" } },
    "planetary": { "type": "array", "items": { "$ref": "#/$defs/planetary" } },
    "task": { "type": "object", "required": ["tool"], "additionalProperties": false, "description": "What the machine is for: the tool, where it works, how fast and how accurately", "properties": { "tool": { "type": "string", "description": "An anchor, <item>.<anchor>" }, "sheet": { "type": "object", "required": ["at"], "additionalProperties": false, "properties": { "size": {}, "width": { "type": "number" }, "height": { "type": "number" }, "landscape": { "type": "boolean" }, "at": { "$ref": "#/$defs/vec3" }, "normal": { "$ref": "#/$defs/vec3" }, "u": { "$ref": "#/$defs/vec3" } } }, "region": { "type": "object" }, "volume": { "type": "object" }, "speed": { "$ref": "#/$defs/expr", "description": "mm/s" }, "accuracy": { "$ref": "#/$defs/expr", "description": "mm" }, "accel": { "$ref": "#/$defs/expr", "description": "mm/s², for planning" }, "elbow": { "enum": ["left", "right"] }, "deflection": { "$ref": "#/$defs/expr", "description": "mm of link deflection at the tool, an estimate; else worked out from the parts when there is a payload" }, "payload": { "$ref": "#/$defs/expr", "description": "kg at the tool" }, "grip": { "type": "object", "description": "A compliant gripper on a servo: { servo, horn, leaf: { length, thickness, width }, travel, friction, lever, margin }" }, "pen": { "type": "object", "description": "Servo angles for the pen: { up, down }" } } },
    "gait": { "type": "object", "required": ["legs", "pattern", "stride", "lift", "period", "height", "mass"], "additionalProperties": false, "description": "Poses in time: the feet by anchor, a pattern, and the body", "properties": { "legs": { "type": "array", "items": { "type": "string" } }, "pattern": {}, "stride": { "$ref": "#/$defs/expr" }, "lift": { "$ref": "#/$defs/expr" }, "period": { "$ref": "#/$defs/expr" }, "height": { "$ref": "#/$defs/expr" }, "mass": { "$ref": "#/$defs/expr" }, "steps": { "$ref": "#/$defs/expr" }, "com": { "$ref": "#/$defs/vec3" }, "clearance": { "$ref": "#/$defs/expr" } } },
    "power": { "type": "object", "additionalProperties": false, "properties": { "margin": { "type": "number" } } },
    "wires": { "type": "array", "description": "Wires between anchors, their length measured through every pose", "items": { "type": "object", "required": ["from", "to"], "additionalProperties": false, "properties": { "id": { "type": "string" }, "from": { "type": "string" }, "to": { "type": "string" }, "via": { "type": "array", "items": { "type": "string" }, "description": "Anchors or path joints the wire is routed by" }, "gauge": { "type": "string", "description": "awg22" }, "colour": { "type": "string" }, "conductors": { "type": "number" }, "connectors": { "type": "array", "items": { "type": "string" } }, "current": { "type": "number", "description": "A: else a motor's rated current at either end, or a signal's" }, "note": { "type": "string" } } } },
    "gravity": { "$ref": "#/$defs/vec3", "description": "Which way down is, for masses in loads (default [0, 0, -1])" },
    "loads": { "type": "array", "description": "What the assembly has to do: a torque (N m) or force (N) on a joint, or a mass (kg) carried at an anchor", "items": { "type": "object", "additionalProperties": false, "properties": { "joint": { "type": "string" }, "torque": { "$ref": "#/$defs/expr" }, "force": { "$ref": "#/$defs/expr" }, "mass": { "$ref": "#/$defs/expr" }, "at": { "$ref": "#/$defs/anchorRef" }, "note": { "type": "string" } } } },
    "poses": { "type": "object", "description": "Named sets of joint values ({ \"hinge\": 90 }), and of items' variables (\"action.travel\": 25: a flexure drawn bent in that pose, printed as drawn)", "additionalProperties": { "type": "object", "additionalProperties": { "$ref": "#/$defs/values" } } },
    "pose": { "type": "string" }
  },
  "$defs": {
    "expr": { "type": ["number", "string"] },
    "vec3": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "$ref": "#/$defs/expr" } },
    "values": { "anyOf": [{ "$ref": "#/$defs/expr" }, { "type": "array", "items": { "$ref": "#/$defs/expr" } }] },
    "names": { "anyOf": [{ "type": "string" }, { "type": "array", "items": { "type": "string" } }] },
    "item": {
      "type": "object",
      "required": ["id"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "object": { "type": "string" },
        "assembly": { "type": "string" },
        "motor": { "type": "object", "required": ["model"], "additionalProperties": false, "description": "A motor from @rulecad/motors: bought, not printed; its shaft turns the joint it drives", "properties": { "model": { "type": "string" }, "drives": { "type": "string" }, "set": { "type": "object", "description": "Figures that differ from the catalogue's, by name" }, "speed": { "$ref": "#/$defs/expr", "description": "The motor's speed, rpm (default: what it does comfortably)" }, "margin": { "$ref": "#/$defs/expr", "description": "How many times over the torque must be (default 2)" }, "duty": { "$ref": "#/$defs/expr", "description": "The share of the time it runs, 0 to 1 (default 1), for its heat" }, "screw": { "type": "string", "description": "The screws through a motor's plain holes, if not the size they take: M3" }, "driver": { "type": "string", "description": "The bought driver item this motor plugs into" }, "leadscrew": { "type": "object", "additionalProperties": false, "required": ["lead"], "properties": { "lead": { "$ref": "#/$defs/expr" }, "diameter": { "$ref": "#/$defs/expr" }, "friction": { "$ref": "#/$defs/expr" } } }, "belt": { "type": "object", "additionalProperties": false, "required": ["teeth"], "properties": { "teeth": { "$ref": "#/$defs/expr" }, "pitch": { "$ref": "#/$defs/expr" }, "stiffness": { "$ref": "#/$defs/expr", "description": "N per mm of strain, per mm of belt width" }, "width": { "$ref": "#/$defs/expr" }, "length": { "$ref": "#/$defs/expr" }, "load": { "$ref": "#/$defs/expr" } } }, "current": { "type": "number", "description": "A per coil, as set on the driver (default its rated current)" }, "cooled": { "type": "boolean", "description": "The driver has a heat sink and moving air" }, "microsteps": { "type": "number", "description": "Steps to a full step (default 16): resolution, not accuracy" } } },
        "bought": { "type": "string", "description": "A part from a rule set (\"608\", \"drv8825\"): bought, not printed; drawn faint from its figures, with anchors from what it is" },
        "variant": { "type": "string" },
        "set": { "type": "object" },
        "at": { "$ref": "#/$defs/vec3" },
        "rotate": { "$ref": "#/$defs/vec3" },
        "place": {},
        "from": {},
        "repeat": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "x": { "type": "object", "properties": { "count": { "$ref": "#/$defs/expr" }, "step": { "$ref": "#/$defs/expr" } } },
            "y": { "type": "object", "properties": { "count": { "$ref": "#/$defs/expr" }, "step": { "$ref": "#/$defs/expr" } } },
            "layout": { "type": "string" },
            "step": { "$ref": "#/$defs/expr" },
            "per": { "type": "object", "additionalProperties": { "type": "string" } },
            "each": { "type": "object" },
            "rows": {},
            "width": { "type": "string" }
          }
        }
      }
    },
    "fit": {
      "type": "object",
      "required": ["a", "b"],
      "additionalProperties": false,
      "properties": {
        "a": { "$ref": "#/$defs/names" },
        "b": { "$ref": "#/$defs/names" },
        "engage": { "$ref": "#/$defs/expr", "description": "a goes at least this far (mm) onto b along the joint between them: a part slid onto a shaft or a pin, not resting on its end" },
        "radius": { "$ref": "#/$defs/expr", "description": "With engage: how near the joint's axis to look (mm, default 10)" },
        "shaft": { "anyOf": [{ "type": "boolean" }, { "enum": ["slide", "press"] }], "description": "a or b is a motor, and the other takes its shaft: reads the bore from the part as drawn" },
        "seat": { "anyOf": [{ "type": "boolean" }, { "enum": ["press", "slip"] }, { "type": "number" }], "description": "a or b is a bought bearing, and the other its printed seat: reads the pocket as drawn against the bearing's rules and the printer's fit (fit.seat)" },
        "fastens": { "type": "boolean", "description": "a and b are fastened together (pins, screws, a press): what holds a part that has no joint" },
        "fastener": { "type": "string", "description": "What does the fastening (an M3 × 12 screw): named on the shopping list and the assembly step" },
        "count": { "$ref": "#/$defs/expr", "description": "With fastener: how many" },
        "access": { "type": "string", "description": "<item>.<anchor>: where the screw's tool comes from, its z axis pointing out along the screw. Whatever stands on that line goes on after the screw; if nothing can, assembly.order says so" },
        "min": { "$ref": "#/$defs/expr" },
        "max": { "$ref": "#/$defs/expr" },
        "note": { "type": "string" },
        "label": { "type": "string" },
        "poses": { "type": "array", "items": { "type": "string" } },
        "holes": { "type": "boolean" },
        "depth": { "$ref": "#/$defs/expr" },
        "direction": { "enum": ["up", "down"] },
        "ring": { "$ref": "#/$defs/expr" },
        "into": { "type": "string" },
        "within": { "$ref": "#/$defs/expr", "description": "With an anchor name (item@anchor): only faces this close to it (mm, default 10)" }
      }
    },
    "anchorRef": {
      "anyOf": [
        { "type": "string", "description": "item.anchor" },
        { "type": "object", "required": ["item"], "additionalProperties": false, "properties": { "item": { "type": "string" }, "at": { "$ref": "#/$defs/vec3" }, "axis": { "$ref": "#/$defs/vec3" }, "ref": { "$ref": "#/$defs/vec3" }, "rotate": { "$ref": "#/$defs/vec3" } } },
        { "type": "object", "required": ["at"], "additionalProperties": false, "properties": { "at": { "$ref": "#/$defs/vec3" }, "axis": { "$ref": "#/$defs/vec3" }, "ref": { "$ref": "#/$defs/vec3" }, "rotate": { "$ref": "#/$defs/vec3" } } }
      ]
    },
    "joint": {
      "type": "object",
      "required": ["id", "type", "parent", "child"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "label": { "type": "string" },
        "type": { "enum": ["fixed", "revolute", "prismatic", "cylindrical", "ball", "path"] },
        "parent": { "$ref": "#/$defs/anchorRef" },
        "child": { "$ref": "#/$defs/anchorRef" },
        "min": { "$ref": "#/$defs/values" },
        "max": { "$ref": "#/$defs/values" },
        "value": { "$ref": "#/$defs/values" },
        "support": { "type": "object", "additionalProperties": false, "description": "What takes this joint's tipping load: bought bearings, or printed clips (read by FE)", "properties": { "bearings": { "type": "array", "items": { "type": "string" } }, "clips": { "type": "array", "items": { "type": "string" } }, "pitch": { "$ref": "#/$defs/expr", "description": "Diameter the clips stand on, mm" }, "cell": { "$ref": "#/$defs/expr", "description": "FE cell, mm" } } },
        "errors": { "type": "object", "description": "What this joint adds to the error at the tool, degrees, by name (play, twist, bearing): an expression reading a rule, so a measurement moves it", "additionalProperties": { "$ref": "#/$defs/expr" } },
        "home": { "type": "object", "additionalProperties": false, "required": ["endstop"], "description": "How this joint finds zero", "properties": { "endstop": { "type": "string", "description": "An item.anchor at the switch" }, "direction": { "enum": [1, -1] } } },
        "brake": { "type": "string", "description": "What holds this joint with the power off (a ratchet, a detent): counted by motor.holds" },
        "follow": { "type": "string" },
        "ratio": { "$ref": "#/$defs/expr" },
        "offset": { "$ref": "#/$defs/values" },
        "path": { "type": "array", "items": { "$ref": "#/$defs/vec3" } },
        "cone": { "$ref": "#/$defs/expr" },
        "mesh": {
          "type": "object",
          "description": "Gears: this joint's gear meshes with the gear on the joint named by with, which drives it",
          "required": ["with", "module", "teeth"],
          "additionalProperties": false,
          "properties": {
            "with": { "type": "string" },
            "module": { "$ref": "#/$defs/expr" },
            "teeth": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "$ref": "#/$defs/expr" } },
            "shift": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "$ref": "#/$defs/expr" } },
            "pressureAngle": { "$ref": "#/$defs/expr" },
            "backlash": { "$ref": "#/$defs/expr" },
            "ring": { "type": "boolean" },
            "bevel": { "type": "boolean" },
            "worm": { "anyOf": [{ "type": "boolean" }, { "type": "object", "additionalProperties": false, "properties": { "diameter": { "$ref": "#/$defs/expr" }, "hand": { "enum": ["right", "left"] } } }] }
          }
        }
      }
    },
    "planetary": {
      "type": "object",
      "description": "A planetary gearbox: one of sun, carrier and ring held, the one named by drive turning, the rest following it in phase",
      "required": ["sun", "carrier", "ring", "planets", "module", "teeth"],
      "additionalProperties": false,
      "properties": {
        "output": { "type": "object", "required": ["ring", "planet", "teeth"], "additionalProperties": false, "description": "A compound planetary: a second ring, on the planets' second step", "properties": { "ring": { "type": "string" }, "planet": { "$ref": "#/$defs/expr" }, "teeth": { "$ref": "#/$defs/expr" } } },
        "sun": { "type": "string" }, "carrier": { "type": "string" }, "ring": { "type": "string" },
        "planets": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "drive": { "enum": ["sun", "carrier", "ring"] },
        "module": { "$ref": "#/$defs/expr" },
        "teeth": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "$ref": "#/$defs/expr" } },
        "pressureAngle": { "$ref": "#/$defs/expr" },
        "backlash": { "$ref": "#/$defs/expr" },
        "note": { "type": "string" }
      }
    },
    "loop": {
      "type": "object",
      "required": ["a", "b"],
      "additionalProperties": false,
      "properties": { "a": { "$ref": "#/$defs/anchorRef" }, "b": { "$ref": "#/$defs/anchorRef" }, "label": { "type": "string" }, "note": { "type": "string" } }
    }
  }
}
