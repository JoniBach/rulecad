{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jonibach.github.io/rulecad/schemas/problem.schema.json",
  "title": "rulecad optimisation problem",
  "description": "A flat part to optimise (projects/<project>/problems/<name>.json): where material may go, what must stay solid or empty, where it's held and loaded, and what it's made of. Numbers are expressions, as in objects: of its variables and the rule sets it uses. cad optimise runs it; a design reads the result through a variable of type problem.",
  "type": "object",
  "required": ["material", "thickness", "cell", "volume", "space", "supports", "loads"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "title": { "type": "string" },
    "description": { "type": "string" },
    "uses": { "type": "array", "items": { "type": "string" }, "description": "Rule sets: the material's, the printer's, the part's own" },
    "variables": { "type": "object", "description": "As in objects" },
    "variants": { "type": "object", "additionalProperties": { "type": "object" }, "description": "Named settings of variables with tweak ranges, picked as name:variant" },
    "material": { "type": "string", "description": "A rule set with modulus (MPa), poisson and, for safety factors, strength (MPa)" },
    "thickness": { "$ref": "#/$defs/expr", "description": "The plate's thickness, mm" },
    "cell": { "$ref": "#/$defs/expr", "description": "The grid's cell size, mm: smaller is finer and slower" },
    "volume": { "$ref": "#/$defs/expr", "description": "The share of the space to fill, 0 to 1 (keep regions count towards it)" },
    "filter": { "$ref": "#/$defs/expr", "description": "Filter radius, mm: about the thinnest member (default 1.5 cells)" },
    "penal": { "$ref": "#/$defs/expr", "description": "The penalty on part-solid cells (default 3)" },
    "projection": { "type": "boolean", "description": "Sharpen the result to solid and empty (default true)" },
    "steps": { "type": "integer", "description": "At most this many steps (default 300)" },
    "space": { "oneOf": [{ "$ref": "#/$defs/region" }, { "type": "array", "items": { "$ref": "#/$defs/region" } }], "description": "Where material may go" },
    "keep": { "type": "array", "items": { "$ref": "#/$defs/region" }, "description": "Must stay solid: bosses round bolt holes" },
    "avoid": { "type": "array", "items": { "$ref": "#/$defs/region" }, "description": "Must stay empty: holes, clearances (avoid wins over keep)" },
    "supports": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/support" } },
    "loads": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/load" } },
    "cases": { "type": "object", "additionalProperties": { "$ref": "#/$defs/expr" }, "description": "Each load case's weight in the optimisation (default 1); 0 analyses it without optimising for it" },
    "outline": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "smooth": { "type": "integer", "description": "Smoothing passes (default 4)" },
        "min_area": { "$ref": "#/$defs/expr", "description": "Holes and islands smaller than this (mm²) are dropped" }
      }
    }
  },
  "$defs": {
    "expr": { "type": ["number", "string"] },
    "point": { "type": "array", "items": { "$ref": "#/$defs/expr" }, "minItems": 2, "maxItems": 2 },
    "region": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "at": { "$ref": "#/$defs/point", "description": "The centre, mm" },
        "r": { "$ref": "#/$defs/expr", "description": "A circle's radius" },
        "size": { "type": "array", "items": { "$ref": "#/$defs/expr" }, "minItems": 2, "maxItems": 2, "description": "A rectangle's width and depth" },
        "points": { "type": "array", "items": { "$ref": "#/$defs/point" }, "minItems": 3, "description": "A polygon's corners" },
        "label": { "type": "string" }
      }
    },
    "support": {
      "type": "object",
      "required": ["at"],
      "additionalProperties": false,
      "properties": {
        "at": { "$ref": "#/$defs/point" },
        "r": { "$ref": "#/$defs/expr", "description": "Holds the material within this radius (a bolt hole's)" },
        "fix": { "enum": ["xy", "x", "y"], "description": "Which ways it's held (default both)" },
        "label": { "type": "string" }
      }
    },
    "load": {
      "type": "object",
      "required": ["at", "force"],
      "additionalProperties": false,
      "properties": {
        "at": { "$ref": "#/$defs/point" },
        "r": { "$ref": "#/$defs/expr", "description": "Spread over the material within this radius" },
        "force": { "$ref": "#/$defs/point", "description": "x and y, in N" },
        "case": { "type": "string", "description": "Its load case (default load)" },
        "label": { "type": "string" }
      }
    }
  }
}
