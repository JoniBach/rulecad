{
  "name": "@rulecad/flexures",
  "version": "0.5.16",
  "description": "Compliant mechanisms for printed parts: leaf springs, guides, serpentine springs and notch hinges as JSCAD shapes, each with its stiffness, its strain at a travel, and how it prints.",
  "type": "module",
  "exports": {
    "types": "./flexures.d.mts",
    "default": "./flexures.mjs"
  },
  "files": [
    "*.mjs",
    "*.d.mts",
    "README.md",
    "LICENSE",
    "!test.mjs"
  ],
  "license": "MIT",
  "keywords": [
    "jscad",
    "3d-printing",
    "compliant-mechanism",
    "flexure",
    "spring",
    "cad"
  ],
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JoniBach/rulecad.git",
    "directory": "packages/flexures"
  },
  "homepage": "https://github.com/JoniBach/rulecad/tree/main/packages/flexures#readme",
  "bugs": {
    "url": "https://github.com/JoniBach/rulecad/issues"
  },
  "scripts": {
    "test": "node --test"
  },
  "peerDependencies": {
    "@jscad/modeling": "^2.12.0",
    "manifold-3d": "^3.5.0"
  },
  "types": "./flexures.d.mts",
  "peerDependenciesMeta": {
    "manifold-3d": {
      "optional": true
    }
  },
  "dependencies": {
    "@rulecad/fea": "^0.2.5",
    "@rulecad/fixings": "^0.1.5",
    "@rulecad/gears": "^0.3.4"
  }
}
