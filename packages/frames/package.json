  "files": [
    "frames.mjs",
    "frames.d.mts",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "keywords": ["aluminium-extrusion", "t-slot", "v-slot", "frames", "3d-printing", "jscad", "cad"],
  "engines": { "node": ">=20.10" },
  "sideEffects": false,
  "repository": { "type": "git", "url": "git+https://github.com/JoniBach/rulecad.git", "directory": "packages/frames" },
  "homepage": "https://github.com/JoniBach/rulecad/tree/main/packages/frames#readme",
  "bugs": { "url": "https://github.com/JoniBach/rulecad/issues" },
