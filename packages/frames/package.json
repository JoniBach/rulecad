{
  "name": "@rulecad/frames",
  "version": "0.1.2",
  "description": "Structures from beams: a profile (aluminium extrusion of any maker, tube, angle or a printed beam) as a model from its rule set, its section as an outline, and what that section is worth as a beam beside the maker's figures. A beam of it: its mass, its anchors, and its solid as a light box or the true section. Joins, fittings and guides follow.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./frames.d.mts",
      "default": "./frames.mjs"
    }
  },
  "types": "./frames.d.mts",
  "files": [
    "frames.mjs",
    "profile.mjs",
    "beam.mjs",
    "section.mjs",
    "catalogue.mjs",
    "frames.d.mts",
    "profile.d.mts",
    "beam.d.mts",
    "section.d.mts",
    "catalogue.d.mts",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "keywords": ["aluminium-extrusion", "t-slot", "v-slot", "frames", "3d-printing", "jscad", "cad"],
  "engines": {
    "node": ">=20.10"
  },
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JoniBach/rulecad.git",
    "directory": "packages/frames"
  },
  "homepage": "https://github.com/JoniBach/rulecad/tree/main/packages/frames#readme",
  "bugs": {
    "url": "https://github.com/JoniBach/rulecad/issues"
  },
  "scripts": {
    "test": "node --test"
  },
  "peerDependencies": {
    "@jscad/modeling": "^2.12.0"
  },
  "dependencies": {
    "@rulecad/rules": "^0.3.13"
  }
}
