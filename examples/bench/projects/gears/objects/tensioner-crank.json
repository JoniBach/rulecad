{
  "$schema": "https://jonibach.github.io/rulecad/schemas/object.schema.json",
  "name": "tensioner-crank",
  "title": "Tensioner: crank and first pinion",
  "version": "0.1.0",
  "uses": [
    "x1c"
  ],
  "engine": "manifold",
  "description": "A 17-tooth herringbone pinion, right-handed, on a shaft up to a crank.",
  "variables": {
    "module": {
      "value": 1.5,
      "unit": "mm",
      "rule": "Stout teeth for a hand's torque: 5.4 lines across a tooth"
    },
    "helix": {
      "value": 30,
      "unit": "deg",
      "rule": "Herringbone: no thrust, the gears stay on their shafts and centre themselves"
    },
    "width": {
      "value": "x1c.layer * 40",
      "unit": "mm",
      "rule": "Face width, forty layers"
    },
    "bore": {
      "value": "4 + x1c.line / 2",
      "unit": "mm",
      "rule": "A 4 mm shaft, half a line clear"
    },
    "teeth": {
      "value": 17,
      "rule": "The fewest at 20\u00b0 without a shift"
    },
    "shaft": {
      "value": 8,
      "unit": "mm",
      "rule": "The crank's shaft, inside the pinion's roots"
    },
    "shaft_top": {
      "value": 34,
      "unit": "mm",
      "rule": "Up past the second stage and the ratchet"
    },
    "arm": {
      "value": 40,
      "unit": "mm",
      "rule": "The crank's reach"
    },
    "bar": {
      "value": 10,
      "unit": "mm",
      "rule": "The arm's width"
    },
    "thick": {
      "value": "x1c.layer * 20",
      "unit": "mm",
      "rule": "The arm, twenty layers"
    },
    "handle": {
      "value": 25,
      "unit": "mm",
      "rule": "A finger's length"
    },
    "grip": {
      "value": 10,
      "unit": "mm",
      "rule": "The handle across"
    }
  },
  "anchors": {
    "axis": {
      "at": [
        0,
        0,
        0
      ],
      "axis": [
        0,
        0,
        1
      ]
    }
  }
}
