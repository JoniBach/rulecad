{
  "$schema": "https://jonibach.github.io/rulecad/schemas/object.schema.json",
  "name": "sampler-rack",
  "title": "Gear sampler: the rack",
  "version": "0.1.0",
  "uses": [
    "x1c"
  ],
  "description": "The sampler's loose rack: it lies on the plate against the rail and slides as its pinion turns.",
  "anchors": {
    "slide": {
      "at": [
        0,
        0,
        0
      ],
      "axis": [
        1,
        0,
        0
      ]
    }
  },
  "variables": {
    "module": {
      "value": 1,
      "unit": "mm",
      "rule": "Module 1"
    },
    "teeth": {
      "value": 20,
      "rule": "As the plate's rack_teeth"
    },
    "backlash": {
      "value": 0.2,
      "unit": "mm",
      "rule": "As the plate's check_backlash"
    },
    "width": {
      "value": "x1c.layer * 20",
      "unit": "mm",
      "rule": "As the gears"
    },
    "bar": {
      "value": "x1c.line * 8",
      "unit": "mm",
      "rule": "As the plate's rack_bar"
    }
  }
}