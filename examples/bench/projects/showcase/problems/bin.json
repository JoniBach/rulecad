{
  "title": "Bin: a lattice wall branching up from the floor to the rim",
  "description": "A bin 230 mm across and 250 mm tall, filling most of the X1C's 256 mm cube, printed as it stands. Material may go only in an 18 mm wall: a foot ring on the bed is held, a rim ring at the top is leant on (8 points, 200 N, about 20 kg) and kicked sideways (100 N, two directions). The wall should open into braces rising from the foot to the rim, like the twisted tube's diamonds but with no twist to close them into a shell. 6 mm cells (76,800), 8% of the cylinder (about 28% of the wall: 15% came out half solid, 5% a crown of arches that didn't reach the whole rim), 500 steps, struts at least 15 mm thick (2.5 cells), printable without supports. The design adds a 2 mm floor and a sloped ledge under the rim, both finer than a cell. Use it with a bin liner.",
  "uses": ["x1c"],
  "material": "pla",
  "variables": {
    "radius": { "value": 115, "unit": "mm", "rule": "The bin's outer radius" },
    "height": { "value": 250, "unit": "mm", "rule": "The bin's height" },
    "wall": { "value": 18, "unit": "mm", "rule": "The wall's thickness: where material may go" },
    "inner": { "value": "radius - wall", "unit": "mm", "rule": "The inside radius: kept clear" },
    "foot": { "value": 6, "unit": "mm", "rule": "The foot ring's height" },
    "rim": { "value": 12, "unit": "mm", "rule": "The rim ring's height" },
    "mid": { "value": "radius - wall / 2", "unit": "mm", "rule": "The wall's middle radius: where the loads act" },
    "lean": { "value": 200, "unit": "N", "rule": "Someone leaning on the rim, about 20 kg, over eight points" },
    "kick": { "value": 100, "unit": "N", "rule": "A sideways knock at the rim" },
    "build": { "value": "+z", "choice": ["none", "+z"], "rule": "+z: only what prints without supports, standing up; none: optimised freely" }
  },
  "variants": { "free": { "build": "none" } },
  "overhang": "build",
  "cell": 6,
  "volume": 0.08,
  "filter": 15,
  "space": { "at": [0, 0, "height / 2"], "r": "radius", "length": "height", "axis": "z" },
  "keep": [
    { "at": [0, 0, "foot / 2"], "r": "radius", "length": "foot", "axis": "z", "label": "foot ring" },
    { "at": [0, 0, "height - rim / 2"], "r": "radius", "length": "rim", "axis": "z", "label": "rim ring" }
  ],
  "avoid": [
    { "at": [0, 0, "height / 2"], "r": "inner", "length": "height * 2", "axis": "z", "label": "the inside, kept clear" }
  ],
  "supports": [
    { "at": [0, 0, "foot / 2"], "r": "radius", "length": "foot", "axis": "z", "label": "foot ring, on the floor" }
  ],
  "loads": [
    { "at": ["mid * cosd(0)", "mid * sind(0)", "height - rim / 2"], "r": 5, "length": "rim", "axis": "z", "force": [0, 0, "0 - lean / 8"], "case": "lean" },
    { "at": ["mid * cosd(45)", "mid * sind(45)", "height - rim / 2"], "r": 5, "length": "rim", "axis": "z", "force": [0, 0, "0 - lean / 8"], "case": "lean" },
    { "at": ["mid * cosd(90)", "mid * sind(90)", "height - rim / 2"], "r": 5, "length": "rim", "axis": "z", "force": [0, 0, "0 - lean / 8"], "case": "lean" },
    { "at": ["mid * cosd(135)", "mid * sind(135)", "height - rim / 2"], "r": 5, "length": "rim", "axis": "z", "force": [0, 0, "0 - lean / 8"], "case": "lean" },
    { "at": ["mid * cosd(180)", "mid * sind(180)", "height - rim / 2"], "r": 5, "length": "rim", "axis": "z", "force": [0, 0, "0 - lean / 8"], "case": "lean" },
    { "at": ["mid * cosd(225)", "mid * sind(225)", "height - rim / 2"], "r": 5, "length": "rim", "axis": "z", "force": [0, 0, "0 - lean / 8"], "case": "lean" },
    { "at": ["mid * cosd(270)", "mid * sind(270)", "height - rim / 2"], "r": 5, "length": "rim", "axis": "z", "force": [0, 0, "0 - lean / 8"], "case": "lean" },
    { "at": ["mid * cosd(315)", "mid * sind(315)", "height - rim / 2"], "r": 5, "length": "rim", "axis": "z", "force": [0, 0, "0 - lean / 8"], "case": "lean" },
    { "at": ["mid", 0, "height - rim / 2"], "r": 5, "length": "rim", "axis": "z", "force": ["kick", 0, 0], "case": "kick-x" },
    { "at": [0, "mid", "height - rim / 2"], "r": 5, "length": "rim", "axis": "z", "force": [0, "kick", 0], "case": "kick-y" }
  ],
  "cases": { "lean": 1, "kick-x": 0.5, "kick-y": 0.5 },
  "steps": 500
}
