{
  "$schema": "https://jonibach.github.io/rulecad/schemas/object.schema.json",
  "name": "shoulder-sun",
  "title": "Shoulder sun",
  "version": "0.1.0",
  "uses": [
    "x1c"
  ],
  "engine": "manifold",
  "description": "The sun on the motor's shaft, with a hub up through both stages.",
  "anchors": {
    "axis": {
      "at": [
        0,
        0,
        "0 - gap"
      ],
      "axis": [
        0,
        0,
        1
      ]
    }
  },
  "variables": {
    "gap": {
      "value": 0.3,
      "unit": "mm",
      "rule": "Clear of the base"
    },
    "module": {
      "value": 1,
      "unit": "mm",
      "rule": "The gears'"
    },
    "teeth": {
      "value": 18,
      "rule": "As the planets' first step"
    },
    "width": {
      "value": 8,
      "unit": "mm",
      "rule": "The first stage"
    },
    "hub": {
      "value": 12,
      "unit": "mm",
      "rule": "Inside the planets' second step"
    },
    "tall": {
      "value": 16,
      "unit": "mm",
      "rule": "Up through both stages"
    },
    "tip": {
      "value": 12.1,
      "unit": "mm",
      "rule": "Where the shaft's 24 mm tip is from the sun's underside: through the stand, dial and base"
    },
    "comp": {
      "value": 0.1,
      "unit": "mm",
      "rule": "Printed holes shrink by this: set it from the fit bar",
      "tweak": {
        "min": -0.2,
        "max": 0.4
      }
    },
    "segments": {
      "value": 48,
      "rule": "Facets on round holes and corners"
    }
  }
}
