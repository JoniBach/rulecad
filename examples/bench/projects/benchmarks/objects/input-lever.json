{
  "$schema": "https://jonibach.github.io/rulecad/schemas/object.schema.json",
  "name": "input-lever",
  "title": "Shoulder input lever",
  "version": "0.1.0",
  "uses": [
    "x1c"
  ],
  "engine": "manifold",
  "description": "A printed copy of the motor's shaft on a lever: with the motor off the stand, this turns the sun by hand for the efficiency test.",
  "variables": {
    "length": {
      "value": 60,
      "unit": "mm",
      "rule": "The lever"
    },
    "bar": {
      "value": 12,
      "unit": "mm",
      "rule": "Width"
    },
    "thick": {
      "value": 4,
      "unit": "mm",
      "rule": "Twenty layers"
    },
    "corner": {
      "value": 5,
      "unit": "mm",
      "rule": "Rounded ends"
    },
    "hole": {
      "value": 3,
      "unit": "mm",
      "rule": "For a string"
    },
    "r1": {
      "value": 25,
      "unit": "mm",
      "rule": "A hole"
    },
    "r2": {
      "value": 50,
      "unit": "mm",
      "rule": "A hole"
    },
    "segments": {
      "value": 48,
      "rule": "Facets on round holes and corners"
    }
  }
}
