{
  "$schema": "https://jonibach.github.io/rulecad/schemas/object.schema.json",
  "name": "shoulder-speck",
  "title": "Carrier (not printed)",
  "version": "0.1.0",
  "uses": [
    "x1c"
  ],
  "engine": "manifold",
  "description": "Nothing to print: the planets ride on the sun and the two rings. This carries their joints in the assembly.",
  "role": "reference",
  "anchors": {
    "axis": {
      "at": [
        0,
        0,
        0
      ],
      "axis": [
        0,
        0,
        1
      ]
    },
    "a": {
      "at": [
        "centre",
        0,
        0
      ],
      "axis": [
        0,
        0,
        1
      ]
    },
    "b": {
      "at": [
        "0 - centre / 2",
        "centre * sind(sixty)",
        0
      ],
      "axis": [
        0,
        0,
        1
      ]
    },
    "c": {
      "at": [
        "0 - centre / 2",
        "0 - centre * sind(sixty)",
        0
      ],
      "axis": [
        0,
        0,
        1
      ]
    }
  },
  "variables": {
    "r": {
      "value": 0.2,
      "unit": "mm",
      "rule": "A speck"
    },
    "centre": {
      "value": 18,
      "unit": "mm",
      "rule": "Sun to planet"
    },
    "far": {
      "value": 70,
      "unit": "mm",
      "rule": "Well clear of the gears"
    },
    "sixty": {
      "value": 60,
      "unit": "deg",
      "rule": "Each planet from the x axis"
    },
    "half_turn": {
      "value": 180,
      "unit": "deg",
      "rule": "Degrees to radians"
    },
    "segments": {
      "value": 48,
      "rule": "Facets on round holes and corners"
    }
  }
}
