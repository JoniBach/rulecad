{
  "$schema": "https://jonibach.github.io/rulecad/schemas/object.schema.json",
  "name": "shoulder-planet",
  "title": "Shoulder planet",
  "version": "0.1.0",
  "uses": [
    "x1c"
  ],
  "engine": "manifold",
  "description": "A stepped planet, in one piece. Print three.",
  "anchors": {
    "axis": {
      "at": [
        0,
        0,
        "width * 2 + gap"
      ],
      "axis": [
        0,
        0,
        -1
      ]
    }
  },
  "variables": {
    "gap": {
      "value": 0.3,
      "unit": "mm",
      "rule": "Clear of the base"
    },
    "module": {
      "value": 1,
      "unit": "mm",
      "rule": "The gears'"
    },
    "low": {
      "value": 18,
      "rule": "On the sun and the held ring"
    },
    "high": {
      "value": 21,
      "rule": "On the output ring"
    },
    "width": {
      "value": 8,
      "unit": "mm",
      "rule": "Each stage"
    },
    "segments": {
      "value": 48,
      "rule": "Facets on round holes and corners"
    }
  }
}
