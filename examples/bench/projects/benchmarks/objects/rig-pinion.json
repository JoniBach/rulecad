{
  "$schema": "https://jonibach.github.io/rulecad/schemas/object.schema.json",
  "name": "rig-pinion",
  "title": "Mesh rig: pinion and lever",
  "version": "0.1.0",
  "uses": [
    "x1c"
  ],
  "engine": "manifold",
  "description": "The pinion standing on its lever: the lever is as wide as the gear, so nothing overhangs. Turned over, the teeth go towards the plate.",
  "anchors": {
    "axis": {
      "at": [
        0,
        0,
        "lever_t + width + gap"
      ],
      "axis": [
        0,
        0,
        -1
      ],
      "ref": [
        1,
        0,
        0
      ]
    }
  },
  "variables": {
    "module": {
      "value": 1,
      "unit": "mm",
      "rule": "The shoulder's"
    },
    "teeth": {
      "value": 14,
      "rule": "The pinion"
    },
    "shift": {
      "value": 0.2,
      "rule": "As the mesh"
    },
    "backlash": {
      "value": 0.2,
      "unit": "mm",
      "rule": "Change to the card's winner",
      "tweak": {
        "min": 0,
        "max": 0.5
      }
    },
    "width": {
      "value": 6,
      "unit": "mm",
      "rule": "The gear"
    },
    "lever_t": {
      "value": 3,
      "unit": "mm",
      "rule": "The lever"
    },
    "bore": {
      "value": 5.4,
      "unit": "mm",
      "rule": "On a 5 mm printed pin: change to the fit bar's winner"
    },
    "bar": {
      "value": 16.6,
      "unit": "mm",
      "rule": "As wide as the gear's tips, so they all stand on it"
    },
    "corner": {
      "value": 8,
      "unit": "mm",
      "rule": "Rounded ends"
    },
    "reach": {
      "value": 60,
      "unit": "mm",
      "rule": "The lever, away from the wheel"
    },
    "gap": {
      "value": 0.4,
      "unit": "mm",
      "rule": "Clear of the plate"
    },
    "hole": {
      "value": 3,
      "unit": "mm",
      "rule": "For a string"
    },
    "r1": {
      "value": 20,
      "unit": "mm",
      "rule": "A hole"
    },
    "r2": {
      "value": 40,
      "unit": "mm",
      "rule": "A hole"
    },
    "r3": {
      "value": 60,
      "unit": "mm",
      "rule": "A hole"
    },
    "segments": {
      "value": 48,
      "rule": "Facets on round holes and corners"
    }
  }
}
