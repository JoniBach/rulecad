{
  "$schema": "https://jonibach.github.io/rulecad/schemas/object.schema.json",
  "name": "shoulder-clip",
  "title": "Shoulder clip",
  "version": "0.1.0",
  "uses": [
    "x1c"
  ],
  "engine": "manifold",
  "description": "A flat tab screwed to a post, its nose over the output ring's flange. Print three.",
  "anchors": {
    "base": {
      "at": [
        0,
        0,
        0
      ],
      "axis": [
        0,
        0,
        1
      ],
      "ref": [
        1,
        0,
        0
      ]
    }
  },
  "variables": {
    "reach": {
      "value": 6,
      "unit": "mm",
      "rule": "In over the flange's edge"
    },
    "back": {
      "value": 4,
      "unit": "mm",
      "rule": "Round the post"
    },
    "wide": {
      "value": 8,
      "unit": "mm",
      "rule": "As wide as the post and a little"
    },
    "thick": {
      "value": 3,
      "unit": "mm",
      "rule": "Fifteen layers"
    },
    "hole": {
      "value": 3.5,
      "unit": "mm",
      "rule": "M3 clearance"
    },
    "corner": {
      "value": 1.5,
      "unit": "mm",
      "rule": "Corners rounded"
    },
    "segments": {
      "value": 48,
      "rule": "Facets on round holes and corners"
    }
  }
}
