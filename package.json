{
  "name": "rulecad",
  "private": true,
  "description": "A kit for designing physical things you can trace, check, share and print.",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "license": "MIT",
  "scripts": {
    "test": "node --test packages/*/test.mjs test/*.test.mjs",
    "test:browser": "node --test test/viewer.browser.mjs test/docs.browser.mjs test/live.browser.mjs",
    "types": "node scripts/types.mjs",
    "docs": "node packages/viewer/scripts/build.mjs && node docs/build.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@jscad/modeling": "^2.13.0",
    "manifold-3d": "^3.5.4",
    "typescript": "^5.9.3"
  }
}
