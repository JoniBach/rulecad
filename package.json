{
  "name": "rulecad",
  "private": true,
  "description": "A kit for designing physical things you can trace, check, share and print.",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "license": "MIT",
  "scripts": {
    "test": "node --test packages/*/test.mjs test/*.test.mjs",
    "test:browser": "node --test test/viewer.browser.mjs",
    "types": "node scripts/types.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@jscad/modeling": "^2.13.0",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "@tscircuit/math-utils": "0.0.36"
  }
}
